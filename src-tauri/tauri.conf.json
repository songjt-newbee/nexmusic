{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NexMusic",
  "version": "0.1.0",
  "identifier": "top.nexmusic.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:4173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NexMusic",
        "width": 390,
        "height": 844,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
