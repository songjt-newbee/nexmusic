{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "NexMusic default capability",
  "windows": ["main", "netease-login", "kugou-login", "qqmusic-login"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "opener:default",
    "store:default",
    "dialog:default"
  ]
}
